# Backend
APP_NAME="Cardiac Digital Twin Research Platform"
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Paths
DATA_DIR=./data
MODEL_DIR=./backend/models
SAMPLE_DATA_DIR=./data/sample

# Supabase (server-side only for service role)
# Leave empty to run in local in-memory / file mode.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PYNQ / FPGA — optional. Software DSP is the default.
PYNQ_ENABLE=false
PYNQ_BOARD_NAME=
PYNQ_BITSTREAM_PATH=
PYNQ_IP=

# Research defaults (experimental parameters, not clinical claims)
DEFAULT_FS=250
DEFAULT_OBSERVATION_SECONDS=300
DEFAULT_HORIZON_SECONDS=600
